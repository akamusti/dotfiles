monitor=,preferred,auto,1

env = LIBVA_DRIVER_NAME,nvidia
env = __GLX_VENDOR_LIBRARY_NAME,nvidia
env = XDG_SESSION_TYPE,wayland
env = XDG_CURRENT_DESKTOP,Hyprland
env = QT_QPA_PLATFORM,wayland
env = QT_WAYLAND_DISABLE_WINDOWDECORATION,1
env = SDL_VIDEODRIVER,wayland

cursor { no_hardware_cursors = true }

exec-once = hyprpaper
exec-once = waybar
exec-once = swaync
exec-once = /usr/libexec/polkit-kde-authentication-agent-1
exec-once = nm-applet --indicator &
exec-once = wl-paste --watch cliphist store &

input {
    kb_layout = tr,us
    kb_options = grp:alt_shift_toggle
    follow_mouse = 1
    touchpad { natural_scroll = yes }
}

general {
    gaps_in = 6
    gaps_out = 14
    border_size = 2
    col.active_border = rgb(cba6f7) rgb(89b4fa) 45deg
    col.inactive_border = rgb(313244)
    layout = dwindle
}

decoration {
    rounding = 12
    active_opacity = 1.0
    inactive_opacity = 0.93
    shadow { enabled = yes; range = 12; render_power = 3; color = rgba(1a1a2ecc) }
    blur { enabled = true; size = 8; passes = 3; new_optimizations = true }
}

misc { background_color = rgb(1e1e2e); disable_hyprland_logo = true }

animations {
    enabled = yes
    bezier = myBezier, 0.05, 0.9, 0.1, 1.05
    animation = windows, 1, 6, myBezier
    animation = workspaces, 1, 6, myBezier
    animation = fade, 1, 5, default
    animation = border, 1, 8, default
}

$mainMod = SUPER
bind = $mainMod, Return, exec, kitty
bind = $mainMod, T, exec, kitty
bind = ALT, Return, exec, kitty
bind = $mainMod, D, exec, wofi --show drun
bind = $mainMod, Space, exec, wofi --show drun
bind = $mainMod, Q, killactive,
bind = $mainMod SHIFT, M, exit,
bind = $mainMod, F, fullscreen,
bind = $mainMod, V, togglefloating,
bind = $mainMod, left, movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up, movefocus, u
bind = $mainMod, down, movefocus, d
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = , Print, exec, grim -g "$(slurp)" ~/Pictures/screenshot-$(date +%F-%H%M%S).png
bindl = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindl = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindl = , XF86AudioRaiseVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindl = , XF86MonBrightnessDown, exec, brightnessctl set 5%-
bindl = , XF86MonBrightnessUp, exec, brightnessctl set 5%+

windowrulev2 = float, class:^(pavucontrol|nm-connection-editor|org.kde.polkit-kde-authentication-agent-1)$
windowrulev2 = center, class:^(pavucontrol|nm-connection-editor)$
windowrulev2 = opacity 0.95 0.9, class:^(kitty|org.kde.dolphin)$
